<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Transfert des données — Africa Vision Voyage Gestion</title>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<style>
:root{--bg:#f2f5f8;--surface:#fff;--ink:#132033;--muted:#5d6b7c;--line:#dce3eb;--accent:#d97d22;--good:#1d7f54;--bad:#b9381a;--nav:#0f2338}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 "Segoe UI",system-ui,-apple-system,sans-serif;padding:24px 16px 60px}
.wrap{max-width:860px;margin:0 auto;display:flex;flex-direction:column;gap:18px}
h1{font-size:22px;margin:0}
h2{font-size:17px;margin:0 0 10px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:18px}
.step{border-left:4px solid var(--accent)}
p{margin:0 0 10px}
.muted{color:var(--muted);font-size:13.5px}
.btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface);padding:9px 16px;border-radius:8px;cursor:pointer;font:inherit;font-weight:500}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn:disabled{opacity:.45;cursor:not-allowed}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
label.fld{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--muted);min-width:230px;flex:1}
label.fld input{padding:9px 11px;border:1px solid var(--line);border-radius:8px;font:inherit}
table{width:100%;border-collapse:collapse;font-size:14px;margin-top:8px}
th,td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--line)}
th{font-size:12.5px;color:var(--muted);background:#eaf0f5}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
.log{background:var(--nav);color:#cfe0f0;border-radius:8px;padding:12px 14px;font:12.5px/1.6 ui-monospace,Menlo,Consolas,monospace;max-height:280px;overflow-y:auto;white-space:pre-wrap;word-break:break-word}
.ok{color:#4cc492;font-weight:600}
.err{color:#f08060;font-weight:600}
.pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600;background:#eaf0f5;color:var(--muted)}
.pill.on{background:#e1f3ea;color:var(--good)}
.bar{height:9px;border-radius:5px;background:#eaf0f5;overflow:hidden;margin-top:10px}
.bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .2s}
.warn{background:#fbf0dc;border:1px solid #e8cf9f;border-radius:8px;padding:12px 14px;font-size:14px}
code{background:#eaf0f5;padding:1px 5px;border-radius:4px;font-size:13px}
</style>
</head>
<body>
<div class="wrap">

  <div class="card" style="border-left:4px solid var(--nav)">
    <h1>Transfert des données de la plateforme</h1>
    <p class="muted" style="margin-top:8px">De l'ancien projet <code>gestion-comptable-15fc9</code> vers le nouveau projet <code>gestion--comptable-et-billet</code>.</p>
    <p class="muted" style="margin:0">Rien n'est supprimé dans l'ancien projet : les données y restent intactes. Vous pouvez relancer le transfert plusieurs fois sans créer de doublons, chaque enregistrement gardant son identifiant.</p>
  </div>

  <div class="card step">
    <h2>1. Connexion à l'ancien projet</h2>
    <p class="muted">Utilisez le compte avec lequel vous ouvriez la plateforme. Si l'ancien projet est en lecture libre, vous pouvez passer cette étape.</p>
    <div class="row">
      <label class="fld"><span>Adresse e-mail</span><input id="mail" type="email" autocomplete="username" placeholder="vous@exemple.com"></label>
      <label class="fld"><span>Mot de passe</span><input id="pass" type="password" autocomplete="current-password" placeholder="••••••••"></label>
    </div>
    <div class="row" style="margin-top:12px">
      <button class="btn primary" id="bLogin" type="button">Se connecter</button>
      <button class="btn" id="bSkip" type="button">Passer cette étape</button>
      <span id="authState" class="pill">non connecté</span>
    </div>
  </div>

  <div class="card step">
    <h2>2. Lecture de l'ancien projet</h2>
    <p class="muted">Compte les enregistrements présents, sans rien modifier.</p>
    <button class="btn primary" id="bRead" type="button" disabled>Lire l'ancien projet</button>
    <div id="counts"></div>
    <div class="row" style="margin-top:12px"><button class="btn" id="bBackup" type="button" disabled>Télécharger une sauvegarde JSON</button></div>
  </div>

  <div class="card step">
    <h2>3. Écriture dans le nouveau projet</h2>
    <p class="muted">Copie tout dans <code>gestion--comptable-et-billet</code>.</p>
    <button class="btn primary" id="bWrite" type="button" disabled>Lancer le transfert</button>
    <div class="bar"><i id="bar"></i></div>
    <div class="log" id="log" style="margin-top:12px">En attente.</div>
  </div>

  <div class="warn">
    <b>À faire avant le transfert, dans le nouveau projet :</b> créer la base Firestore, activer la connexion « E-mail / mot de passe », et recréer les comptes de connexion — les comptes ne se déplacent pas d'un projet Firebase à l'autre.
  </div>

</div>

<script>
const OLD = {
  apiKey: "AIzaSyB2Cbf9dCUuXKG2EDJtdSq5hGXim7d6qtc",
  authDomain: "gestion-comptable-15fc9.firebaseapp.com",
  projectId: "gestion-comptable-15fc9",
  storageBucket: "gestion-comptable-15fc9.firebasestorage.app",
  messagingSenderId: "191996450348",
  appId: "1:191996450348:web:deae64816726d289ee2389"
};
const NEW = {
  apiKey: "AIzaSyCsg8c8tZiyVARs6vZJFtQ8U_ZpM1aZgDA",
  authDomain: "gestion--comptable-et-billet.firebaseapp.com",
  projectId: "gestion--comptable-et-billet",
  storageBucket: "gestion--comptable-et-billet.firebasestorage.app",
  messagingSenderId: "499323605799",
  appId: "1:499323605799:web:68a74ea1d476b9b7d04f02"
};
const COLS = ['clients','fournisseurs','billets','transports','hotels','circuits','visas','groupes','inscrits','factures','paiements','caisse'];

const $ = s => document.querySelector(s);
const appOld = firebase.initializeApp(OLD, 'ancien');
const appNew = firebase.initializeApp(NEW, 'nouveau');
const dbOld = appOld.firestore(), dbNew = appNew.firestore(), authOld = appOld.auth();

let DATA = null, CONF = null;

function log(msg, cls) {
  const el = $('#log');
  if (el.textContent === 'En attente.') el.textContent = '';
  const line = document.createElement('div');
  if (cls) line.className = cls;
  line.textContent = msg;
  el.appendChild(line);
  el.scrollTop = el.scrollHeight;
}
function authErr(code) {
  return ({
    'auth/invalid-email': "Adresse e-mail non valide.",
    'auth/user-not-found': "Aucun compte avec cette adresse dans l'ancien projet.",
    'auth/wrong-password': "Mot de passe incorrect.",
    'auth/invalid-credential': "E-mail ou mot de passe incorrect.",
    'auth/invalid-login-credentials': "E-mail ou mot de passe incorrect.",
    'auth/missing-password': "Entrez votre mot de passe.",
    'auth/too-many-requests': "Trop de tentatives. Patientez quelques minutes.",
    'auth/network-request-failed': "Pas de connexion internet."
  })[code] || "La connexion a échoué.";
}

$('#bLogin').addEventListener('click', async () => {
  const mail = $('#mail').value.trim(), pass = $('#pass').value;
  if (!mail || !pass) return log("Entrez votre e-mail et votre mot de passe.", 'err');
  $('#bLogin').disabled = true;
  try {
    await authOld.signInWithEmailAndPassword(mail, pass);
    $('#authState').textContent = 'connecté : ' + mail;
    $('#authState').className = 'pill on';
    $('#bRead').disabled = false;
    log("Connecté à l'ancien projet.", 'ok');
  } catch (e) {
    log(authErr(e && e.code), 'err');
  } finally { $('#bLogin').disabled = false; }
});

$('#bSkip').addEventListener('click', () => {
  $('#bRead').disabled = false;
  $('#authState').textContent = 'sans connexion';
  log("Étape de connexion passée. La lecture échouera si l'ancien projet exige une connexion.");
});

$('#bRead').addEventListener('click', async () => {
  $('#bRead').disabled = true;
  DATA = {}; CONF = null;
  let total = 0, failed = 0;
  const rows = [];
  for (const col of COLS) {
    try {
      const snap = await dbOld.collection(col).get();
      DATA[col] = snap.docs.map(d => ({ _id: d.id, data: d.data() }));
      total += DATA[col].length;
      rows.push([col, DATA[col].length, true]);
      log(col + ' : ' + DATA[col].length + ' enregistrement(s)');
    } catch (e) {
      failed++;
      DATA[col] = [];
      rows.push([col, 0, false]);
      log(col + ' : lecture impossible (' + ((e && e.code) || e) + ')', 'err');
    }
  }
  try {
    const s = await dbOld.doc('config/agence').get();
    if (s.exists) { CONF = s.data(); log("config/agence : lu (paramètres de l'agence et logo)"); }
    else log('config/agence : aucun paramètre enregistré');
  } catch (e) { log('config/agence : lecture impossible', 'err'); }

  $('#counts').innerHTML = '<table><thead><tr><th>Collection</th><th class="num">Enregistrements</th><th>État</th></tr></thead><tbody>'
    + rows.map(r => '<tr><td>' + r[0] + '</td><td class="num">' + r[1] + '</td><td>' + (r[2] ? '<span style="color:#1d7f54;font-weight:600">lu</span>' : '<span style="color:#b9381a;font-weight:600">erreur</span>') + '</td></tr>').join('')
    + '</tbody><tfoot><tr><th>Total</th><th class="num">' + total + '</th><th></th></tr></tfoot></table>';

  if (failed === COLS.length) {
    log("Aucune collection n'a pu être lue : connectez-vous à l'étape 1, puis réessayez.", 'err');
    $('#bRead').disabled = false;
    return;
  }
  log('Lecture terminée : ' + total + ' enregistrement(s) au total.', 'ok');
  $('#bWrite').disabled = (total === 0 && !CONF);
  $('#bBackup').disabled = false;
  $('#bRead').disabled = false;
});

$('#bBackup').addEventListener('click', () => {
  const out = { exporte: new Date().toISOString(), projetSource: OLD.projectId, config: CONF };
  COLS.forEach(c => out[c] = (DATA[c] || []).map(x => Object.assign({ id: x._id }, x.data)));
  const url = URL.createObjectURL(new Blob([JSON.stringify(out, null, 2)], { type: 'application/json' }));
  const a = document.createElement('a');
  a.href = url;
  a.download = 'sauvegarde-' + OLD.projectId + '-' + new Date().toISOString().slice(0, 10) + '.json';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 5000);
  log('Sauvegarde JSON téléchargée.', 'ok');
});

$('#bWrite').addEventListener('click', async () => {
  if (!DATA) return;
  $('#bWrite').disabled = true;
  const jobs = [];
  COLS.forEach(col => (DATA[col] || []).forEach(x => jobs.push([col, x._id, x.data])));
  let done = 0, errors = 0;
  log('Transfert de ' + jobs.length + ' enregistrement(s) vers ' + NEW.projectId + '…');
  for (const job of jobs) {
    try {
      await dbNew.collection(job[0]).doc(job[1]).set(job[2]);
    } catch (e) {
      errors++;
      log(job[0] + '/' + job[1] + ' : échec (' + ((e && e.code) || e) + ')', 'err');
    }
    done++;
    $('#bar').style.width = (done / Math.max(1, jobs.length) * 100).toFixed(1) + '%';
    if (done % 25 === 0) log(done + ' / ' + jobs.length + '…');
  }
  if (CONF) {
    try { await dbNew.doc('config/agence').set(CONF); log("Paramètres de l'agence transférés.", 'ok'); }
    catch (e) { errors++; log("Paramètres de l'agence : échec (" + ((e && e.code) || e) + ')', 'err'); }
  }
  $('#bar').style.width = '100%';
  if (errors) log('Transfert terminé avec ' + errors + ' erreur(s) sur ' + jobs.length + '. Vous pouvez relancer : les enregistrements déjà copiés seront simplement réécrits.', 'err');
  else log('Transfert réussi : ' + jobs.length + ' enregistrement(s) copiés dans ' + NEW.projectId + '.', 'ok');
  $('#bWrite').disabled = false;
});
</script>
</body>
</html>
